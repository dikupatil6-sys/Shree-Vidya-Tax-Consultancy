# ─────────────────────────────────────────────────────────────
# Shree Vidya Tax Consultancy — Environment Variables
# Copy this file to `.env` for local development, and add the
# SAME variables as Environment Variables in the Vercel dashboard
# (Project → Settings → Environment Variables).
# ─────────────────────────────────────────────────────────────

# Where form submissions are emailed
RECIPIENT_EMAIL=Sumittandel7@gmail.com

# RECOMMENDED sender — sign up free at https://resend.com
# (fast + reliable; set this to avoid Gmail app-password issues)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=Cyber Cafe <onboarding@resend.dev>

# ── Optional fallback sender (only used if RESEND_API_KEY is empty) ──
# Gmail account that AUTHENTICATES the send (2FA + App Password required)
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-16-char-app-password

# ── Optional database (local Express server only) ──
MONGO_URI=mongodb://127.0.0.1:27017/cyber_cafe_db

# ── Port for the optional local Express server ──
PORT=3010
